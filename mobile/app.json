{
  "expo": {
    "name": "Loja da Dedeia",
    "slug": "loja-da-dedeia-admin",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff8f8"
    },
    "android": {
      "package": "com.plynexa.lojadadedeia.admin",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#e95e73"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que a Loja da Dedeia escolha fotos dos produtos.",
          "cameraPermission": "Permitir que a Loja da Dedeia fotografe os produtos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir localização aproximada para registrar o aparelho administrador."
        }
      ]
    ]
  }
}
